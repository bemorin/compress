  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/notices.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "pages:dev": "next build && wrangler pages dev --port 8788",
    "pages:serve": "wrangler pages dev --port 8788"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "framer-motion": "^12.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
